rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user can read and write only their own register.
    // Replace the email below with yours (add more emails, comma separated, to allow other staff their own registers).
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email in ['you@example.com'];
    }
  }
}
